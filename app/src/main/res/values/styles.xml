<resources>

    <!-- xAuto 澶滈棿妯″紡锛堢敤鎴疯拷鍔犻渶姹傦級锛氱埗涓婚鎭㈠ DayNight锛岃窡闅忚溅鏈虹郴缁熸繁娴呰壊锛?         鏃ラ棿鐢?values/colors.xml 娴呰摑鐩橈紝澶滈棿鑷姩鍒?values-night/colors.xml 娣辫壊鐩樸€?-->
    <style name="AppTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowBackground">@drawable/bg_xb</item>
        <item name="android:windowTranslucentNavigation">false</item>
        <item name="android:windowTranslucentStatus">false</item>
        <!-- xAuto锛堢敤鎴蜂换鍔?2 + 澶滈棿妯″紡锛夛細鐘舵€佹爮/瀵艰埅鏍忓彇 xb token 鈥斺€?鏃ラ棿娴呰摑銆佸闂存繁闈涜摑锛?             涓庨〉闈㈤《閮?搴曢儴琛旀帴锛涘浘鏍囨槑鏆楃敤 @bool/status_bar_light锛堟棩闂?true=娣卞浘鏍囷紝
             values-night 閲屼负 false=娴呭浘鏍囷級銆?             杩愯鏃?SystemUI.apply() 杩樹細鎸?fullscreenMode 鍐嶈鐩栦竴娆★紙NONE/STATUS_ONLY=鍚岃壊锛?             IMMERSIVE=閫忔槑锛夛紝杩欓噷鍏滃簳缁欎笉璧?SystemUI 鐨勯〉闈紙濡傚紩瀵奸〉锛変笌鍐峰惎鍔ㄧ獥鍙ｃ€?-->
        <item name="android:statusBarColor">@color/xb_bg_top</item>
        <item name="android:navigationBarColor">@color/xb_bg_bottom</item>
        <item name="android:windowLightStatusBar">@bool/status_bar_light</item>
        <item name="android:windowLightNavigationBar">@bool/status_bar_light</item>
        <item name="colorPrimary">@color/xb_accent</item>
        <item name="colorSecondary">@color/xb_accent</item>
        <item name="colorAccent">@color/xb_accent</item>
        <item name="android:colorAccent">@color/xb_accent</item>
        <item name="android:dialogTheme">@style/DarkAlertDialog</item>
        <item name="android:alertDialogTheme">@style/DarkAlertDialog</item>
        <item name="materialAlertDialogTheme">@style/DarkAlertDialog</item>
    </style>

    <style name="AppTheme.Translucent" parent="android:Theme.Translucent.NoTitleBar" />

    <style name="AppTheme.Fullscreen" parent="AppTheme">
        <item name="android:windowFullscreen">true</item>
    </style>

    <!-- X绠″ 閫傞厤锛氬惎鍔ㄩ〉涓嶅啀鐢?鏁村睆 logo 鍥?锛屾敼鎴愬拰涓荤晫闈竴鑷寸殑娴呰壊娓愬彉搴曪紝
         杩欐牱鍐峰惎鍔ㄦ椂鐪嬪埌鐨勬槸涓€鍧楃函鑳屾櫙锛屼笉浼氭樉寰?鍏ㄥ睆" -->
    <style name="SplashTheme" parent="AppTheme">
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:statusBarColor">@color/xb_bg_top</item>
        <item name="android:navigationBarColor">@color/xb_bg_bottom</item>
        <!-- 鏃ラ棿娴呰摑搴?娣卞浘鏍?true)锛屽闂存繁闈涜摑搴?娴呭浘鏍?false)锛岃 values-night/bools.xml -->
        <item name="android:windowLightStatusBar">@bool/status_bar_light</item>
        <!-- API 27+锛氬鑸爮鍥炬爣鏄庢殫璺熼殢鍚屼竴 bool锛堟棫绯荤粺蹇界暐璇ュ睘鎬э紝淇濇寔榛樿锛夈€?-->
        <item name="android:windowLightNavigationBar">@bool/status_bar_light</item>
    </style>

    <style name="SplashTheme.Fullscreen" parent="SplashTheme">
        <item name="android:windowFullscreen">true</item>
    </style>

