<?xml version="1.0" encoding="utf-8"?>
<!--
  xAuto 夜间模式（用户追加需求）：车机处于深色模式（uiMode=night）时自动启用这一套深色盘，
  与 X管家（cleanroom/XButler values-night）对齐；日间仍用 values/colors.xml 的浅蓝盘。
  两份文件颜色名一一对应，引用方（@color/xxx / R.color.xxx）零改动，系统切深浅色自动换值。

  深色一套要点（照抄车机设置页实测值）：
    底色渐变 #2E2F56 → #282B42，卡片 #333854，正文纯白，次要文字 #C3C7E0，
    深底上的强调色要反过来用"浅蓝" #8FB8F8，否则在靛蓝底上糊成一团。

  values/diauto.xml 的 da_* 全部引用 xb_* token，所以主界面/驾驶设置/诊断/弹窗
  会随这张夜间盘一起变深，不需要另外维护第二套 da_*。
-->
<resources>
    <!-- ===== 设置列表卡片底色（bg_setting_* / bg_info_banner） ===== -->
    <color name="setting_background_color">#FF333854</color>
    <color name="primary_dark">#FF000000</color>
    <color name="divider_color">#1FFFFFFF</color>
    <color name="adaptive_text_color">#FFFFFFFF</color>
    <color name="text_primary">#f7f7f7</color>
    <color name="text_shadow">#00000000</color>
    <color name="segmented_button_stroke">#CCCCCC</color>

    <!-- ===== X管家 配色（夜间深色盘） ===== -->
    <color name="xb_bg_top">#FF2E2F56</color>
    <color name="xb_bg_bottom">#FF282B42</color>
    <color name="xb_card">#FF333854</color>
    <color name="xb_text_primary">#FFFFFFFF</color>
    <color name="xb_text_secondary">#FFC3C7E0</color>
    <color name="xb_accent">#FF8FB8F8</color>
    <color name="xb_ok">#FF4ADE8C</color>
</resources>
