<?xml version="1.0" encoding="utf-8"?>
<!-- xAuto 夜间模式：底色取 xb_bg_top/xb_bg_bottom token，日间浅蓝 / 夜间深靛蓝自动切换。
     启动/窗口底色目前由 bg_xb 承担；这里保持同名资源跟随主题，避免残留引用带出固定底色。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="radial"
        android:centerX="0.6"
        android:centerY="0.6"
        android:gradientRadius="620"
        android:startColor="@color/xb_bg_top"
        android:endColor="@color/xb_bg_bottom" />
</shape>
